                 Order Now
              </a>
            </div>
          </div>
        </article>
      `).join("");
    }

    // Category Filter Click
    filterTabs.addEventListener("click", (e) => {
      if (!e.target.classList.contains("filter-btn")) return;
      document.querySelectorAll(".filter-btn").forEach(btn => btn.classList.remove("active"));
      e.target.classList.add("active");
      currentCategory = e.target.dataset.category;
      renderProducts();
    });

    // Live Search Input
    searchInput.addEventListener("input", renderProducts);

    // Add Item to Quote Drawer
    function addToQuote(id) {
      const product = products.find(p => p.id === id);
      if (!product) return;
      quoteList.push(product);
      updateQuoteUI();
      quoteDrawer.classList.add("open");
    }

    // Remove Item from Quote Drawer
    function removeFromQuote(index) {
      quoteList.splice(index, 1);
      updateQuoteUI();
    }

    // Update Quote Drawer UI
    function updateQuoteUI() {
      quoteCount.textContent = quoteList.length;

      if (quoteList.length === 0) {
        quoteItemsContainer.innerHTML = `<p style="color: var(--text-muted); text-align: center; margin-top: 30px;">Your quote list is empty. Add furniture from the showroom to request prices or place an order.</p>`;
        quoteTotal.textContent = "₦0";
        return;
      }

      let total = 0;
      quoteItemsContainer.innerHTML = quoteList.map((item, idx) => {
        total += item.price;
        return `
          <div class="quote-item">
            <div>
              <strong style="display: block; font-size: 0.92rem;">${item.name}</strong>
              <span style="font-size: 0.84rem; color: var(--accent); font-weight: 600;">${formatNaira(item.price)}</span>
            </div>
            <button class="remove-item" onclick="removeFromQuote(${idx})">Remove</button>
          </div>
        `;
      }).join("");

      quoteTotal.textContent = formatNaira(total);
    }

    // Drawer Open / Close
    document.getElementById("openQuoteBtn").addEventListener("click", () => quoteDrawer.classList.add("open"));
    document.getElementById("closeQuoteBtn").addEventListener("click", () => quoteDrawer.classList.remove("open"));
    quoteDrawer.addEventListener("click", (e) => {
      if (e.target === quoteDrawer) quoteDrawer.classList.remove("open");
    });

    // Checkout Quote via WhatsApp
    document.getElementById("checkoutWhatsappBtn").addEventListener("click", () => {
      if (quoteList.length === 0) return alert("Please add at least one item to your quote list first.");
      const itemsText = quoteList.map((i, idx) => `${idx + 1}. ${i.name} - ${formatNaira(i.price)}`).join("\n");
      const total = quoteList.reduce((sum, i) => sum + i.price, 0);
      const message = `Hello Prince Victorious Best Furnitures,\n\nI would like a quote/order for the following items:\n${itemsText}\n\nEstimated Total: ${formatNaira(total)}\n\nPlease let me know availability and delivery details.`;
      window.open(`https://wa.me/${BUSINESS_WHATSAPP}?text=${encodeURIComponent(message)}`, "_blank");
