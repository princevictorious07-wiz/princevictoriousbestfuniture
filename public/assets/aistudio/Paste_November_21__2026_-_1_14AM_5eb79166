<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Prince Victorious Best Furnitures | Bespoke & Luxury Furniture in Wukari, Taraba</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,700;1,500&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #faf8f5;
      --surface: #ffffff;
      --surface-alt: #f2ede4;
      --primary: #3b2416;      /* Rich Mahogany */
      --primary-light: #5c3a24;
      --accent: #c58b38;       /* Warm Brass / Gold */
      --accent-hover: #a87226;
      --text: #221c18;
      --text-muted: #665c54;
      --border: #e5ddd0;
      --whatsapp: #25D366;
      --whatsapp-dark: #1ebe5d;
      --radius: 12px;
      --shadow: 0 10px 30px rgba(59, 36, 22, 0.07);
      --transition: all 0.28s ease;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      background-color: var(--bg);
      color: var(--text);
      line-height: 1.6;
      overflow-x: hidden;
    }

    h1, h2, h3, .brand-font {
      font-family: 'Playfair Display', serif;
      color: var(--primary);
    }

    a {
      text-decoration: none;
      color: inherit;
    }

    img {
      max-width: 100%;
      display: block;
    }

    .container {
      width: 92%;
      max-width: 1200px;
      margin: 0 auto;
    }

    /* Top Info Bar */
    .top-bar {
      background: var(--primary);
      color: #f4ece1;
      font-size: 0.85rem;
      padding: 8px 0;
    }

    .top-bar .container {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 8px;
    }

    .top-bar span {
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    /* Navigation */
    header {
      background: rgba(255, 255, 255, 0.96);
      backdrop-filter: blur(10px);
      position: sticky;
      top: 0;
      z-index: 1000;
      border-bottom: 1px solid var(--border);
    }

    .nav-wrap {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 16px 0;
    }

    .logo {
      display: flex;
      flex-direction: column;
    }

    .logo-title {
      font-family: 'Playfair Display', serif;
      font-size: 1.35rem;
      font-weight: 700;
      color: var(--primary);
      line-height: 1.1;
    }

    .logo-sub {
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 2px;
      color: var(--accent);
      font-weight: 700;
    }

    nav ul {
      display: flex;
      list-style: none;
      gap: 28px;
      align-items: center;
    }

    nav a {
      font-weight: 500;
      font-size: 0.95rem;
      color: var(--text);
      transition: var(--transition);
    }

    nav a:hover {
      color: var(--accent);
    }

    .nav-actions {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .quote-btn {
      background: var(--primary);
      color: #fff;
      border: none;
      padding: 10px 18px;
      border-radius: 50px;
      font-weight: 600;
      font-size: 0.9rem;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      transition: var(--transition);
    }

    .quote-btn:hover {
      background: var(--primary-light);
      transform: translateY(-1px);
    }

    .badge {
      background: var(--accent);
      color: #fff;
      font-size: 0.75rem;
      padding: 2px 8px;
      border-radius: 99px;
      font-weight: 700;
    }

    .menu-toggle {
      display: none;
      background: none;
      border: 1px solid var(--border);
      padding: 8px 12px;
      border-radius: 8px;
      font-size: 1.2rem;
      cursor: pointer;
      color: var(--primary);
    }

    /* Hero Section */
    .hero {
      position: relative;
      padding: 72px 0 84px;
      background: linear-gradient(135deg, #f6f1e9 0%, #ebe1d1 100%);
      overflow: hidden;
    }

    .hero-grid {
      display: grid;
      grid-template-columns: 1.1fr 0.9fr;
      gap: 48px;
      align-items: center;
    }

    .hero-tag {
      display: inline-block;
      background: rgba(197, 139, 56, 0.16);
      color: var(--primary);
      padding: 6px 14px;
      border-radius: 50px;
      font-size: 0.82rem;
      font-weight: 700;
      letter-spacing: 0.5px;
      margin-bottom: 18px;
    }

    .hero h1 {
      font-size: clamp(2.2rem, 4.2vw, 3.4rem);
      line-height: 1.15;
      margin-bottom: 20px;
    }

    .hero p {
      font-size: 1.05rem;
      color: var(--text-muted);
      margin-bottom: 30px;
      max-width: 560px;
    }

    .hero-btns {
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
    }

    .btn {
      padding: 14px 26px;
      border-radius: 8px;
      font-weight: 600;
      font-size: 0.96rem;
      cursor: pointer;
      transition: var(--transition);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      border: none;
    }

    .btn-primary {
      background: var(--primary);
      color: #fff;
    }

    .btn-primary:hover {
      background: var(--primary-light);
      transform: translateY(-2px);
    }

    .btn-accent {
      background: var(--accent);
      color: #fff;
    }

    .btn-accent:hover {
      background: var(--accent-hover);
      transform: translateY(-2px);
    }

    .btn-outline {
      background: transparent;
      border: 1.5px solid var(--primary);
      color: var(--primary);
    }

    .btn-outline:hover {
      background: var(--primary);
      color: #fff;
    }

    .hero-image-card {
      position: relative;
      border-radius: 20px;
      overflow: hidden;
      box-shadow: 0 24px 50px rgba(59, 36, 22, 0.18);
    }

    .hero-image-card img {
      width: 100%;
      height: 460px;
      object-fit: cover;
    }

    .hero-floating-card {
      position: absolute;
      bottom: 20px;
      left: 20px;
      right: 20px;
      background: rgba(255, 255, 255, 0.94);
      backdrop-filter: blur(8px);
      padding: 16px 20px;
      border-radius: 12px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
    }

    /* Trust Features */
    .features-strip {
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      padding: 36px 0;
    }

    .features-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 24px;
    }

    .feature-item {
      display: flex;
      align-items: flex-start;
      gap: 14px;
    }

    .feature-icon {
      width: 44px;
      height: 44px;
      border-radius: 10px;
      background: var(--surface-alt);
      color: var(--accent);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.3rem;
      flex-shrink: 0;
    }

    .feature-item h4 {
      font-size: 1rem;
      margin-bottom: 4px;
      color: var(--primary);
    }

    .feature-item p {
      font-size: 0.86rem;
      color: var(--text-muted);
    }

    /* Section Shared */
    section {
      padding: 80px 0;
    }

    .section-header {
      text-align: center;
      max-width: 680px;
      margin: 0 auto 48px;
    }

    .section-header h2 {
      font-size: clamp(1.8rem, 3vw, 2.5rem);
      margin-bottom: 12px;
    }

    .section-header p {
      color: var(--text-muted);
    }

    /* Catalog & Filter */
    .filter-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 16px;
      margin-bottom: 32px;
    }

    .filter-tabs {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }

    .filter-btn {
      background: var(--surface);
      border: 1px solid var(--border);
      padding: 9px 18px;
      border-radius: 50px;
      font-weight: 600;
      font-size: 0.88rem;
      cursor: pointer;
      color: var(--text);
      transition: var(--transition);
    }

    .filter-btn.active, .filter-btn:hover {
      background: var(--primary);
      color: #fff;
      border-color: var(--primary);
    }

    .search-box {
      padding: 10px 16px;
      border: 1px solid var(--border);
      border-radius: 50px;
      min-width: 240px;
      font-family: inherit;
      font-size: 0.9rem;
      background: var(--surface);
    }

    .products-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(275px, 1fr));
      gap: 28px;
    }

    .product-card {
      background: var(--surface);
      border-radius: var(--radius);
      overflow: hidden;
      border: 1px solid var(--border);
      box-shadow: var(--shadow);
      display: flex;
      flex-direction: column;
      transition: var(--transition);
    }

    .product-card:hover {
      transform: translateY(-6px);
    }

    .product-img-wrap {
      position: relative;
      height: 230px;
      overflow: hidden;
      background: #eae4da;
    }

    .product-img-wrap img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.5s ease;
    }

    .product-card:hover .product-img-wrap img {
      transform: scale(1.06);
    }

    .product-cat {
      position: absolute;
      top: 12px;
      left: 12px;
      background: rgba(59, 36, 22, 0.88);
      color: #fff;
      font-size: 0.74rem;
      font-weight: 600;
      padding: 4px 10px;
      border-radius: 6px;
      text-transform: uppercase;
    }

    .product-body {
      padding: 20px;
      flex-grow: 1;
      display: flex;
      flex-direction: column;
    }

    .product-title {
      font-size: 1.18rem;
      margin-bottom: 6px;
    }

    .product-desc {
      font-size: 0.88rem;
      color: var(--text-muted);
      margin-bottom: 14px;
      flex-grow: 1;
    }

    .product-meta {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 16px;
      padding-top: 12px;
      border-top: 1px solid var(--border);
    }

    .product-price {
      font-weight: 700;
      font-size: 1.1rem;
      color: var(--primary);
    }

    .product-wood {
      font-size: 0.78rem;
      color: var(--accent);
      font-weight: 600;
    }

    .product-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
    }

    .btn-sm {
      padding: 10px 12px;
      font-size: 0.83rem;
      border-radius: 8px;
    }

    /* Custom Order Section */
    .custom-section {
      background: var(--primary);
      color: #fff;
    }

    .custom-section h2, .custom-section h3 {
      color: #fff;
    }

    .custom-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 48px;
      align-items: center;
    }

    .custom-list {
      list-style: none;
      margin: 24px 0;
      display: grid;
      gap: 14px;
    }

    .custom-list li {
      display: flex;
      align-items: center;
      gap: 12px;
      color: #eadfce;
    }

    .custom-form-card {
      background: var(--surface);
      color: var(--text);
      padding: 32px;
      border-radius: 16px;
      box-shadow: 0 20px 40px rgba(0,0,0,0.25);
    }

    .custom-form-card h3 {
      color: var(--primary);
      margin-bottom: 6px;
    }

    .form-group {
      margin-bottom: 16px;
    }

    .form-group label {
      display: block;
      font-size: 0.86rem;
      font-weight: 600;
      margin-bottom: 6px;
      color: var(--primary);
    }

    .form-control {
      width: 100%;
      padding: 11px 14px;
      border: 1px solid var(--border);
      border-radius: 8px;
      font-family: inherit;
      font-size: 0.94rem;
      background: #fcfbf9;
    }

    .form-control:focus {
      outline: none;
      border-color: var(--accent);
      background: #fff;
    }

    .form-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
    }

    /* About & Testimonials */
    .about-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 48px;
      align-items: center;
    }

    .stats-row {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
      margin-top: 28px;
    }

    .stat-box {
      background: var(--surface);
      padding: 18px;
      border-radius: 12px;
      border: 1px solid var(--border);
      text-align: center;
    }

    .stat-box strong {
      display: block;
      font-size: 1.6rem;
      color: var(--accent);
      font-family: 'Playfair Display', serif;
    }

    .testimonials-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 24px;
      margin-top: 40px;
    }

    .testimonial-card {
      background: var(--surface);
      padding: 26px;
      border-radius: var(--radius);
      border: 1px solid var(--border);
      box-shadow: var(--shadow);
    }

    .stars {
      color: var(--accent);
      margin-bottom: 10px;
      letter-spacing: 2px;
    }

    /* Contact & Location */
    .contact-section {
      background: var(--surface-alt);
    }

    .contact-grid {
      display: grid;
      grid-template-columns: 1fr 1.1fr;
      gap: 36px;
    }

    .contact-card {
      background: var(--surface);
      padding: 32px;
      border-radius: 16px;
      border: 1px solid var(--border);
    }

    .info-item {
      display: flex;
      gap: 16px;
      margin-bottom: 22px;
      align-items: flex-start;
    }

    .info-icon {
      width: 46px;
      height: 46px;
      background: var(--surface-alt);
      color: var(--primary);
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.25rem;
      flex-shrink: 0;
    }

    .map-frame {
      width: 100%;
      height: 100%;
      min-height: 360px;
      border: 0;
      border-radius: 16px;
      box-shadow: var(--shadow);
    }

    /* Footer */
    footer {
      background: #1d120b;
      color: #d6c9ba;
      padding: 56px 0 24px;
    }

    .footer-grid {
      display: grid;
      grid-template-columns: 1.4fr 1fr 1fr;
      gap: 36px;
      padding-bottom: 36px;
      border-bottom: 1px solid rgba(255,255,255,0.1);
    }

    .footer-title {
      color: #fff;
      font-family: 'Playfair Display', serif;
      font-size: 1.25rem;
      margin-bottom: 14px;
    }

    .footer-links {
      list-style: none;
      display: grid;
      gap: 10px;
      font-size: 0.92rem;
    }

    .footer-links a:hover {
      color: var(--accent);
    }

    .footer-bottom {
      text-align: center;
      padding-top: 24px;
      font-size: 0.85rem;
      color: #9e8f80;
    }

    /* Quote Drawer / Modal */
    .drawer-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.55);
      display: none;
      justify-content: flex-end;
      z-index: 2000;
    }

    .drawer-backdrop.open {
      display: flex;
    }

    .drawer {
      width: 100%;
      max-width: 420px;
      background: var(--surface);
      height: 100%;
      padding: 28px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      overflow-y: auto;
    }

    .drawer-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-bottom: 16px;
      border-bottom: 1px solid var(--border);
    }

    .close-btn {
      background: none;
      border: none;
      font-size: 1.5rem;
      cursor: pointer;
      color: var(--text);
    }

    .quote-items {
      flex-grow: 1;
      padding: 20px 0;
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .quote-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: var(--bg);
      padding: 12px;
      border-radius: 10px;
      border: 1px solid var(--border);
      gap: 10px;
    }

    .remove-item {
      color: #c0392b;
      background: none;
      border: none;
      cursor: pointer;
      font-weight: 700;
      font-size: 0.85rem;
    }

    /* Floating WhatsApp Button */
    .whatsapp-float {
      position: fixed;
      bottom: 24px;
      right: 24px;
      background: var(--whatsapp);
      color: #fff;
      padding: 14px 20px;
      border-radius: 50px;
      font-weight: 700;
      font-size: 0.92rem;
      box-shadow: 0 10px 25px rgba(37, 211, 102, 0.35);
      display: flex;
      align-items: center;
      gap: 8px;
      z-index: 1500;
      transition: var(--transition);
    }

    .whatsapp-float:hover {
      background: var(--whatsapp-dark);
      transform: translateY(-3px);
    }

    /* Responsive */
    @media (max-width: 900px) {
      .hero-grid, .custom-grid, .about-grid, .contact-grid, .footer-grid {
        grid-template-columns: 1fr;
      }

      nav ul {
        display: none;
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        background: var(--surface);
        flex-direction: column;
        padding: 20px;
        border-bottom: 1px solid var(--border);
        gap: 16px;
      }

      nav ul.show {
        display: flex;
      }

      .menu-toggle {
        display: block;
      }

      .hero-image-card img {
        height: 340px;
      }
    }

    @media (max-width: 520px) {
      .form-row, .product-actions {
        grid-template-columns: 1fr;
      }
      .top-bar {
        display: none;
      }
    }
  </style>
</head>
