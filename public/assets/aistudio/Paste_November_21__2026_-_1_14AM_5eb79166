    function getCustomFormData() {
      const name = document.getElementById("custName").value.trim();
      const phone = document.getElementById("custPhone").value.trim();
      const type = document.getElementById("custType").value;
      const budget = document.getElementById("custBudget").value.trim() || "Not specified";
      const details = document.getElementById("custDetails").value.trim();
      return { name, phone, type, budget, details };
    }

    document.getElementById("customOrderForm").addEventListener("submit", (e) => {
      e.preventDefault();
      const { name, phone, type, budget, details } = getCustomFormData();
      const msg = `Hello Prince Victorious Best Furnitures,\n\n*Custom Furniture Request*\nName: ${name}\nPhone: ${phone}\nCategory: ${type}\nEstimated Budget: ${budget}\nDetails: ${details}`;
      window.open(`https://wa.me/${BUSINESS_WHATSAPP}?text=${encodeURIComponent(msg)}`, "_blank");
