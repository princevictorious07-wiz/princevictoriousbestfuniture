    // Checkout Quote via Email
    document.getElementById("checkoutEmailBtn").addEventListener("click", () => {
      if (quoteList.length === 0) return alert("Please add at least one item to your quote list first.");
      const itemsText = quoteList.map((i, idx) => `${idx + 1}. ${i.name} - ${formatNaira(i.price)}`).join("\n");
      const total = quoteList.reduce((sum, i) => sum + i.price, 0);
      const subject = "Furniture Quote Request - Prince Victorious Best Furnitures";
      const body = `Hello Prince Victorious Best Furnitures,\n\nI would like to request a quote for:\n${itemsText}\n\nEstimated Total: ${formatNaira(total)}\n\nThank you.`;
      window.location.href = `mailto:${BUSINESS_EMAIL}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    });

