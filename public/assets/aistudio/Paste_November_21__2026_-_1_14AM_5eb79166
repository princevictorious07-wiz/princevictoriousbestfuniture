      }

      productsGrid.innerHTML = filtered.map(item => `
        <article class="product-card">
          <div class="product-img-wrap">
            <span class="product-cat">${item.categoryLabel}</span>
            <img src="${item.image}" alt="${item.name}" loading="lazy">
